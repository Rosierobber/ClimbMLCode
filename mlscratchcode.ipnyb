{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"\n!pip install -q imbalanced-learn imbalanced-ensemble scikit-learn pandas numpy scipy\nimport os\nfile_path = \"/usr/local/lib/python3.13/dist-packages/imbalanced_ensemble/pipeline.py\"\nif os.path.exists(file_path):\n    with open(file_path, \"r\") as f:\n        code = f.read()\n    code = code.replace(\n        \"from sklearn.utils import _print_elapsed_time\", \n        \"def _print_elapsed_time(*args, **kwargs): pass\"\n    )\n    \n    \n    code = code.replace(\n        \"from sklearn.utils.metaestimators import if_delegate_has_method\", \n        \"def if_delegate_has_method(delegate):\\n    def decorator(fn): return fn\\n    return decorator\"\n    )\n    \n    with open(file_path, \"w\") as f:\n        f.write(code)\n    \n    print(\"Libraries installed and source code successfully patched! Ready for imports.\")\nelse:\n    print(\"File not found! The pip install might have failed.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-16T09:22:31.18979Z","iopub.execute_input":"2026-10-16T09:22:31.190118Z","iopub.status.idle":"2026-10-16T09:22:35.26216Z","shell.execute_reply.started":"2026-10-16T09:22:31.190092Z","shell.execute_reply":"2026-10-16T09:22:35.26111Z"}},"outputs":[{"name":"stdout","text":"Libraries installed and source code successfully patched! Ready for imports.\n","output_type":"stream"}],"execution_count":6},{"cell_type":"code","source":"import os\nimport time\nimport pickle\nimport pandas as pd\nfrom sklearn.datasets import fetch_openml\nimport warnings\nwarnings.filterwarnings(\"ignore\")\n\nCACHE_DIR = \"results/dataset_cache\"\nos.makedirs(CACHE_DIR, exist_ok=True)\n\n# --- 1. NETWORK RETRY LOGIC ---\ndef _fetch_with_retry(name, version=None, max_retries=4, base_delay=5):\n    \"\"\"Retries fetch_openml with exponential backoff on transient network errors.\"\"\"\n    for attempt in range(1, max_retries + 1):\n        try:\n            if version:\n                return fetch_openml(name=name, version=version, as_frame=True, parser='auto')\n            return fetch_openml(name=name, as_frame=True, parser='auto')\n        except Exception as e:\n            if attempt == max_retries:\n                raise\n            wait = base_delay * (2 ** (attempt - 1)) # 5s, 10s, 20s, 40s...\n            print(f\"[retry] fetch failed for '{name}' (attempt {attempt}/{max_retries}): {e}\")\n            print(f\"[retry] waiting {wait}s before retrying...\")\n            time.sleep(wait)\n\n# --- 2. THE ORIGINAL CACHING LOADER ---\ndef load_dataset(dataset_name):\n    \"\"\"\n    Fetches a dataset from OpenML (with local caching + retry) and applies\n    CLIMB-specific binarization logic.\n    \"\"\"\n    cache_path = os.path.join(CACHE_DIR, f\"{dataset_name}.pkl\")\n    \n    if os.path.exists(cache_path):\n        with open(cache_path, \"rb\") as f:\n            X, y = pickle.load(f)\n        return X, y\n\n    if dataset_name == \"vertebra-column\":\n        bunch = _fetch_with_retry(dataset_name, version=2)\n    elif dataset_name == \"vehicle\":\n        bunch = _fetch_with_retry(dataset_name, version=1)\n    else:\n        bunch = _fetch_with_retry(dataset_name)\n        \n    X = bunch.data\n    y = bunch.target\n    valid_idx = y.dropna().index\n    X = X.loc[valid_idx]\n    y = y.loc[valid_idx]\n    \n    if dataset_name == \"vehicle\":\n        target_class = y.value_counts().idxmax()\n    else:\n        target_class = y.value_counts().idxmin()\n        \n    y_binary = (y == target_class).astype(int)\n    \n    # Clean features for scikit-learn\n    X = X.apply(pd.to_numeric, errors='ignore')\n    X = pd.get_dummies(X, drop_first=True)\n    X = X.fillna(0)\n    \n    # Save to cache for next time — no more repeated network calls!\n    with open(cache_path, \"wb\") as f:\n        pickle.dump((X, y_binary), f)\n        \n    return X, y_binary\n\n# --- 3. REPRODUCTION GATE CHECK ---\ndatasets_to_check = [\"mc2\", \"vertebra-column\", \"haberman\", \"vehicle\"]\n\nprint(\"--- Imbalance Ratio (IR) Check ---\")\nfor dataset_name in datasets_to_check:\n    X, y = load_dataset(dataset_name)\n    counts = y.value_counts()\n    \n    # Majority (0) divided by Minority (1)\n    ir = counts[0] / counts[1]\n    print(f\"Dataset: {dataset_name:<18} | Calculated IR: {round(ir, 2)}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-16T09:22:46.473587Z","iopub.execute_input":"2026-10-16T09:22:46.476463Z","iopub.status.idle":"2026-10-16T09:23:55.786412Z","shell.execute_reply.started":"2026-10-16T09:22:46.476396Z","shell.execute_reply":"2026-10-16T09:23:55.785433Z"}},"outputs":[{"name":"stdout","text":"--- Imbalance Ratio (IR) Check ---\nDataset: mc2                | Calculated IR: 2.1\nDataset: vertebra-column    | Calculated IR: 2.1\nDataset: haberman           | Calculated IR: 2.78\nDataset: vehicle            | Calculated IR: 2.88\n","output_type":"stream"}],"execution_count":7},{"cell_type":"code","source":"import contextlib\nimport sklearn.pipeline\nimport imblearn.pipeline\nimport sklearn.utils\nimport imbalanced_ensemble.pipeline\n\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.tree import DecisionTreeClassifier\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.ensemble import BaggingClassifier\nfrom sklearn.metrics import average_precision_score\nfrom imblearn.pipeline import Pipeline  \nfrom imblearn.under_sampling import RandomUnderSampler, EditedNearestNeighbours, TomekLinks\nfrom imblearn.over_sampling import SMOTE\nfrom imbalanced_ensemble.ensemble import (\n    SelfPacedEnsembleClassifier, UnderBaggingClassifier, \n    OverBaggingClassifier, SMOTEBaggingClassifier\n)\n\n# --- THE FINAL PATCHES ---\n# 1. Fix my bad print_elapsed_time patch so it works as a context manager\n@contextlib.contextmanager\ndef _mock_print_elapsed_time_ctx(*args, **kwargs):\n    yield\n\nimbalanced_ensemble.pipeline._print_elapsed_time = _mock_print_elapsed_time_ctx\nsklearn.utils._print_elapsed_time = _mock_print_elapsed_time_ctx\n\n# 2. Inject the deleted _check_fit_params function back into Pipeline objects\ndef _mock_check_fit_params(self, **fit_params):\n    fit_params_steps = {name: {} for name, step in self.steps if step is not None}\n    for pname, pval in fit_params.items():\n        if '__' not in pname:\n            raise ValueError(f\"Fit parameter {pname} must be formatted as 'stepname__parameter'\")\n        step, param = pname.split('__', 1)\n        fit_params_steps[step][param] = pval\n    return fit_params_steps\n\nif not hasattr(sklearn.pipeline.Pipeline, '_check_fit_params'):\n    sklearn.pipeline.Pipeline._check_fit_params = _mock_check_fit_params\nif not hasattr(imblearn.pipeline.Pipeline, '_check_fit_params'):\n    imblearn.pipeline.Pipeline._check_fit_params = _mock_check_fit_params\n# -------------------------\n\n# --- MINI TEST CONFIGURATION ---\ntest_dataset = \"mc2\"\nmethods_to_test = [\"base\", \"rus\", \"enn\", \"tomek\", \"smote\", \"cost\", \"spe\", \"ubag\", \"obag\", \"sbag\", \"bag\"]\nclassifiers_to_test = [\"decision_tree\", \"logistic_regression\"]\n\nquick_cv = StratifiedKFold(n_splits=2, shuffle=True, random_state=42)\n\nprint(f\"--- Starting Dry Run on {test_dataset} ---\")\nX, y = load_dataset(test_dataset)\nprint(f\"Data loaded. Shape: {X.shape}\\n\")\n\nprint(f\"{'Classifier':<20} | {'Method':<10} | {'Status':<10} | {'AUPRC (Fold 0)'}\")\nprint(\"-\" * 65)\n\nfor clf_name in classifiers_to_test:\n    for method in methods_to_test:\n        \n        # 1. Base Estimator\n        base_dt = DecisionTreeClassifier(random_state=42)\n        base_lr = LogisticRegression(max_iter=1000, random_state=42)\n        base_est = base_dt if clf_name == \"decision_tree\" else base_lr\n        \n        # 2. Classifier\n        if method == \"cost\":\n            clf = DecisionTreeClassifier(class_weight='balanced', random_state=42) if clf_name == \"decision_tree\" else LogisticRegression(class_weight='balanced', max_iter=1000, random_state=42)\n        elif method == \"bag\": clf = BaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n        elif method == \"spe\": clf = SelfPacedEnsembleClassifier(estimator=base_est, n_estimators=10, random_state=42)\n        elif method == \"ubag\": clf = UnderBaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n        elif method == \"obag\": clf = OverBaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n        elif method == \"sbag\": clf = SMOTEBaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n        else: clf = base_est\n            \n        # 3. Resampler\n        if method == \"rus\": resampler = RandomUnderSampler(random_state=42)\n        elif method == \"enn\": resampler = EditedNearestNeighbours()\n        elif method == \"tomek\": resampler = TomekLinks()\n        elif method == \"smote\": resampler = SMOTE(random_state=42)\n        else: resampler = \"passthrough\"\n\n        # 4. Pipeline\n        pipe = Pipeline([\n            (\"impute\", SimpleImputer(strategy=\"median\")),\n            (\"scale\", StandardScaler()),\n            (\"resample\", resampler),\n            (\"clf\", clf)\n        ])\n        \n        # 5. Quick Test\n        for tr, te in quick_cv.split(X, y):\n            try:\n                pipe.fit(X.iloc[tr], y.iloc[tr])\n                proba = pipe.predict_proba(X.iloc[te])[:, 1]\n                auprc = average_precision_score(y.iloc[te], proba)\n                print(f\"{clf_name:<20} | {method:<10} | {'SUCCESS':<10} | {auprc:.4f}\")\n            except Exception as e:\n                print(f\"{clf_name:<20} | {method:<10} | ERROR      | {e}\")\n            break","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-16T09:23:55.787938Z","iopub.execute_input":"2026-10-16T09:23:55.788259Z","iopub.status.idle":"2026-10-16T09:23:58.10557Z","shell.execute_reply.started":"2026-10-16T09:23:55.788228Z","shell.execute_reply":"2026-10-16T09:23:58.104519Z"}},"outputs":[{"name":"stdout","text":"--- Starting Dry Run on mc2 ---\nData loaded. Shape: (161, 39)\n\nClassifier           | Method     | Status     | AUPRC (Fold 0)\n-----------------------------------------------------------------\ndecision_tree        | base       | SUCCESS    | 0.4855\ndecision_tree        | rus        | SUCCESS    | 0.3636\ndecision_tree        | enn        | SUCCESS    | 0.3697\ndecision_tree        | tomek      | SUCCESS    | 0.4000\ndecision_tree        | smote      | SUCCESS    | 0.4449\ndecision_tree        | cost       | SUCCESS    | 0.5449\ndecision_tree        | spe        | SUCCESS    | 0.6243\ndecision_tree        | ubag       | SUCCESS    | 0.6204\ndecision_tree        | obag       | SUCCESS    | 0.6993\ndecision_tree        | sbag       | SUCCESS    | 0.6933\ndecision_tree        | bag        | SUCCESS    | 0.6463\nlogistic_regression  | base       | SUCCESS    | 0.6702\nlogistic_regression  | rus        | SUCCESS    | 0.6539\nlogistic_regression  | enn        | SUCCESS    | 0.6055\nlogistic_regression  | tomek      | SUCCESS    | 0.6214\nlogistic_regression  | smote      | SUCCESS    | 0.6686\nlogistic_regression  | cost       | SUCCESS    | 0.6650\nlogistic_regression  | spe        | SUCCESS    | 0.6679\nlogistic_regression  | ubag       | SUCCESS    | 0.6354\nlogistic_regression  | obag       | SUCCESS    | 0.6414\nlogistic_regression  | sbag       | SUCCESS    | 0.6297\nlogistic_regression  | bag        | SUCCESS    | 0.6392\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"import os\nif os.path.exists(\"results_full_sweep.csv\"):\n    os.remove(\"results_full_sweep.csv\")\n    print(\"Corrupted CSV deleted! Ready for a fresh start.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-16T05:36:58.251323Z","iopub.execute_input":"2026-10-16T05:36:58.252349Z","iopub.status.idle":"2026-10-16T05:36:58.257961Z","shell.execute_reply.started":"2026-10-16T05:36:58.252313Z","shell.execute_reply":"2026-10-16T05:36:58.257107Z"}},"outputs":[{"name":"stdout","text":"Corrupted CSV deleted! Ready for a fresh start.\n","output_type":"stream"}],"execution_count":14},{"cell_type":"code","source":"import os\nimport time\nimport numpy as np\nimport pandas as pd\nimport contextlib\nimport warnings\nwarnings.filterwarnings(\"ignore\")\n\nimport sklearn.pipeline\nimport imblearn.pipeline\nimport sklearn.utils\nimport imbalanced_ensemble.pipeline\n\nfrom sklearn.model_selection import RepeatedStratifiedKFold\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.tree import DecisionTreeClassifier\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.ensemble import BaggingClassifier\nfrom sklearn.metrics import average_precision_score, f1_score, balanced_accuracy_score\n\nfrom imblearn.pipeline import Pipeline  \nfrom imblearn.under_sampling import RandomUnderSampler, EditedNearestNeighbours, TomekLinks\nfrom imblearn.over_sampling import SMOTE\nfrom imbalanced_ensemble.ensemble import (\n    SelfPacedEnsembleClassifier, UnderBaggingClassifier, \n    OverBaggingClassifier, SMOTEBaggingClassifier\n)\n\n# --- 1. ESSENTIAL PATCHES (Ensures 100% Stability) ---\n@contextlib.contextmanager\ndef _mock_print_elapsed_time_ctx(*args, **kwargs):\n    yield\n\nimbalanced_ensemble.pipeline._print_elapsed_time = _mock_print_elapsed_time_ctx\nsklearn.utils._print_elapsed_time = _mock_print_elapsed_time_ctx\n\ndef _mock_check_fit_params(self, **fit_params):\n    fit_params_steps = {name: {} for name, step in self.steps if step is not None}\n    for pname, pval in fit_params.items():\n        if '__' not in pname:\n            raise ValueError(f\"Fit parameter {pname} must be formatted as 'stepname__parameter'\")\n        step, param = pname.split('__', 1)\n        fit_params_steps[step][param] = pval\n    return fit_params_steps\n\nif not hasattr(sklearn.pipeline.Pipeline, '_check_fit_params'):\n    sklearn.pipeline.Pipeline._check_fit_params = _mock_check_fit_params\nif not hasattr(imblearn.pipeline.Pipeline, '_check_fit_params'):\n    imblearn.pipeline.Pipeline._check_fit_params = _mock_check_fit_params\n\n# --- 2. CONFIGURATION ---\nRUN_ID = \"climb_extension_final\"\nOUTPUT_CSV = \"results_full_sweep.csv\"\nCV_STRATEGY = RepeatedStratifiedKFold(n_splits=5, n_repeats=5, random_state=42)\n\n# The Full 20 Datasets (Corrected Names)\ndatasets_full = [\n    \"mc2\", \"vertebra-column\", \"haberman\", \"vehicle\", \"wholesale-customers\", \n    \"ilpd-numeric\", \"planning-relax\", \"blood-transfusion-service-center\", \"SPECTF\", \n    \"JapaneseVowels\", \"ibm-employee-attrition\", \"kc1\", \"thoracic-surgery\", \"pc4\", \n    \"adult\", \"bank-marketing\", \"vowel\", \"law-school-admission-bianry\", \n    \"Credit_Approval_Classification\", \"phoneme\"\n]\n\nmethods_to_run = [\"base\", \"rus\", \"enn\", \"tomek\", \"smote\", \"cost\", \"spe\", \"ubag\", \"obag\", \"sbag\", \"bag\"]\nclassifiers_to_run = [\"decision_tree\", \"logistic_regression\"]\n\n# --- 3. FAULT TOLERANCE SETUP ---\ncompleted_runs = set()\nif not os.path.exists(OUTPUT_CSV):\n    with open(OUTPUT_CSV, \"w\") as f:\n        f.write(\"run_id,timestamp,dataset,n_samples,n_features,imbalance_ratio,method,base_classifier,fold,metric,value,fit_seconds,status,notes\\n\")\nelse:\n    df_existing = pd.read_csv(OUTPUT_CSV)\n    for _, row in df_existing.iterrows():\n        signature = f\"{row['dataset']}_{row['method']}_{row['base_classifier']}_{row['fold']}_{row['metric']}\"\n        completed_runs.add(signature)\n\n# --- 4. MASTER EXECUTION LOOP ---\nprint(\"🚀 Initiating Master Sweep...\")\n\nfor dataset_name in datasets_full:\n    print(f\"\\n--- Processing: {dataset_name} ---\")\n    \n    try:\n        # Calls your cached loader from Cell 2!\n        X, y = load_dataset(dataset_name)\n    except Exception as e:\n        print(f\"Skipping {dataset_name} due to network/load error: {e}\")\n        continue\n        \n    n_samples, n_features = X.shape\n    counts = y.value_counts()\n    ir = round(counts[0] / counts[1], 2)\n\n    for clf_name in classifiers_to_run:\n        for method in methods_to_run:\n            \n            # Skip if this specific block is already done (checks fold 24)\n            if f\"{dataset_name}_{method}_{clf_name}_24_auprc\" in completed_runs:\n                continue\n            \n            # Base Estimators\n            base_dt = DecisionTreeClassifier(random_state=42)\n            base_lr = LogisticRegression(max_iter=1000, random_state=42)\n            base_est = base_dt if clf_name == \"decision_tree\" else base_lr\n            \n            # Classifier Setup\n            if method == \"cost\":\n                clf = DecisionTreeClassifier(class_weight='balanced', random_state=42) if clf_name == \"decision_tree\" else LogisticRegression(class_weight='balanced', max_iter=1000, random_state=42)\n            elif method == \"bag\": clf = BaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n            elif method == \"spe\": clf = SelfPacedEnsembleClassifier(estimator=base_est, n_estimators=10, random_state=42)\n            elif method == \"ubag\": clf = UnderBaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n            elif method == \"obag\": clf = OverBaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n            elif method == \"sbag\": clf = SMOTEBaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n            else: clf = base_est\n                \n            # Resampler Setup\n            if method == \"rus\": resampler = RandomUnderSampler(random_state=42)\n            elif method == \"enn\": resampler = EditedNearestNeighbours()\n            elif method == \"tomek\": resampler = TomekLinks()\n            elif method == \"smote\": resampler = SMOTE(random_state=42)\n            else: resampler = \"passthrough\"\n\n            # Pipeline Assembly\n            pipe = Pipeline([\n                (\"impute\", SimpleImputer(strategy=\"median\")),\n                (\"scale\", StandardScaler()),\n                (\"resample\", resampler),\n                (\"clf\", clf)\n            ])\n            \n            # Cross-Validation Loop (25 folds)\n            for fold, (tr, te) in enumerate(CV_STRATEGY.split(X, y)):\n                if f\"{dataset_name}_{method}_{clf_name}_{fold}_auprc\" in completed_runs:\n                    continue \n\n                start_time = time.time()\n                status, notes = \"ok\", \"\"\n                auprc = macro_f1 = bal_acc = np.nan\n                \n                try:\n                    pipe.fit(X.iloc[tr], y.iloc[tr])\n                    fit_time = time.time() - start_time\n                    \n                    proba = pipe.predict_proba(X.iloc[te])[:, 1]\n                    pred = pipe.predict(X.iloc[te])\n                    \n                    if method == \"base\" and clf_name == \"decision_tree\":\n                        notes = f\"Unique_Probs:{len(np.unique(proba))}\"\n                        \n                    auprc = average_precision_score(y.iloc[te], proba)\n                    macro_f1 = f1_score(y.iloc[te], pred, average=\"macro\")\n                    bal_acc = balanced_accuracy_score(y.iloc[te], pred)\n                    \n                except Exception as e:\n                    status, notes = \"error\", str(e).replace(',', ';')\n                    fit_time = time.time() - start_time\n                \n                timestamp = pd.Timestamp.now().isoformat()\n                \n                # Append directly to CSV\n                if status == \"ok\":\n                    lines = [\n                        f\"{RUN_ID},{timestamp},{dataset_name},{n_samples},{n_features},{ir},{method},{clf_name},{fold},auprc,{auprc:.4f},{fit_time:.2f},{status},{notes}\",\n                        f\"{RUN_ID},{timestamp},{dataset_name},{n_samples},{n_features},{ir},{method},{clf_name},{fold},macro_f1,{macro_f1:.4f},{fit_time:.2f},{status},\",\n                        f\"{RUN_ID},{timestamp},{dataset_name},{n_samples},{n_features},{ir},{method},{clf_name},{fold},balanced_accuracy,{bal_acc:.4f},{fit_time:.2f},{status},\"\n                    ]\n                else:\n                    # FIX: Corrected the comma count here from 4 to 3 so pandas doesn't crash!\n                    lines = [f\"{RUN_ID},{timestamp},{dataset_name},{n_samples},{n_features},{ir},{method},{clf_name},{fold},,,{fit_time:.2f},{status},{notes}\"]\n\n                with open(OUTPUT_CSV, \"a\") as f:\n                    f.write(\"\\n\".join(lines) + \"\\n\")\n                    \n        print(f\"  > Completed all methods for {clf_name}\")\n        \nprint(\"\\n🎉 Full Experiment Complete!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-16T09:24:18.422336Z","iopub.execute_input":"2026-10-16T09:24:18.422816Z","iopub.status.idle":"2026-10-16T11:04:57.838821Z","shell.execute_reply.started":"2026-10-16T09:24:18.422788Z","shell.execute_reply":"2026-10-16T11:04:57.837384Z"}},"outputs":[{"name":"stdout","text":"🚀 Initiating Master Sweep...\n\n--- Processing: mc2 ---\n  > Completed all methods for decision_tree\n  > Completed all methods for logistic_regression\n\n--- Processing: vertebra-column ---\n  > Com