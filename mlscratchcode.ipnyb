 class=\"data row18 col7\" >0.709176</td>\n      <td id=\"T_2bd93_row18_col8\" class=\"data row18 col8\" >0.958008</td>\n      <td id=\"T_2bd93_row18_col9\" class=\"data row18 col9\" >0.736772</td>\n      <td id=\"T_2bd93_row18_col10\" class=\"data row18 col10\" >0.877452</td>\n    </tr>\n    <tr>\n      <th id=\"T_2bd93_level0_row19\" class=\"row_heading level0 row19\" >wholesale-customers</th>\n      <td id=\"T_2bd93_row19_col0\" class=\"data row19 col0\" >0.871728</td>\n      <td id=\"T_2bd93_row19_col1\" class=\"data row19 col1\" >0.710652</td>\n      <td id=\"T_2bd93_row19_col2\" class=\"data row19 col2\" >0.726184</td>\n      <td id=\"T_2bd93_row19_col3\" class=\"data row19 col3\" >0.715112</td>\n      <td id=\"T_2bd93_row19_col4\" class=\"data row19 col4\" >0.877344</td>\n      <td id=\"T_2bd93_row19_col5\" class=\"data row19 col5\" >0.676308</td>\n      <td id=\"T_2bd93_row19_col6\" class=\"data row19 col6\" >0.882624</td>\n      <td id=\"T_2bd93_row19_col7\" class=\"data row19 col7\" >0.726956</td>\n      <td id=\"T_2bd93_row19_col8\" class=\"data row19 col8\" >0.884896</td>\n      <td id=\"T_2bd93_row19_col9\" class=\"data row19 col9\" >0.709832</td>\n      <td id=\"T_2bd93_row19_col10\" class=\"data row19 col10\" >0.875148</td>\n    </tr>\n  </tbody>\n</table>\n"},"metadata":{}}],"execution_count":10},{"cell_type":"code","source":"import pandas as pd\n\n# Load the raw CSV\ndf = pd.read_csv(\"results_full_sweep.csv\")\n\n# 1. Show the true sizes of all datasets (largest to smallest)\nprint(\"--- DATASET SIZES ---\")\nsizes = df[['dataset', 'n_samples']].drop_duplicates().sort_values(by='n_samples', ascending=False)\nprint(sizes.to_string(index=False))\n\nprint(\"\\n\" + \"=\"*30 + \"\\n\")\n\n# 2. Check for ANY errors in the entire sweep\nprint(\"--- ERROR CHECK ---\")\nerrors = df[df['status'] == 'error']\n\nif len(errors) == 0:\n    print(\"✅ PERFECT RUN! Zero errors found across all models and datasets.\")\nelse:\n    print(f\"❌ Found {len(errors)} errors. Here is where they happened:\")\n    print(errors[['dataset', 'method', 'base_classifier', 'notes']].drop_duplicates())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-16T11:05:25.304718Z","iopub.execute_input":"2026-10-16T11:05:25.305279Z","iopub.status.idle":"2026-10-16T11:05:25.399521Z","shell.execute_reply.started":"2026-10-16T11:05:25.30525Z","shell.execute_reply":"2026-10-16T11:05:25.398519Z"}},"outputs":[{"name":"stdout","text":"--- DATASET SIZES ---\n                         dataset  n_samples\n                           adult      48842\n                  bank-marketing      45211\n     law-school-admission-bianry      20800\n                  JapaneseVowels       9961\n                         phoneme       5404\n                             kc1       2109\n          ibm-employee-attrition       1470\n                             pc4       1458\n  Credit_Approval_Classification       1000\n                           vowel        990\n                         vehicle        846\nblood-transfusion-service-center        748\n                    ilpd-numeric        583\n                thoracic-surgery        470\n             wholesale-customers        440\n                          SPECTF        349\n                 vertebra-column        310\n                        haberman        306\n                  planning-relax        182\n                             mc2        161\n\n==============================\n\n--- ERROR CHECK ---\n✅ PERFECT RUN! Zero errors found across all models and datasets.\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\n\n# Load your completed sweep\ndf = pd.read_csv(\"results_full_sweep.csv\")\n\n# 1. Drop the extra 20 folds (keep only fold 0, 1, 2, 3, 4)\ndf = df[df['fold'] <= 4].copy()\n\n# 2. Add the missing static columns\ndf['tuning_mode'] = 'default'\n\n# 3. Map the Ensemble Sizes\nensemble_methods = ['spe', 'ubag', 'obag', 'sbag', 'bag']\ndf['ensemble_size'] = df['method'].apply(lambda x: 10 if x in ensemble_methods else 1)\n\n# 4. Map the Method Families\nfamily_mapping = {\n    'base': 'baseline',\n    'rus': 'undersampling',\n    'enn': 'cleaning',\n    'tomek': 'cleaning',\n    'smote': 'oversampling',\n    'spe': 'undersample ensemble',\n    'ubag': 'undersample ensemble',\n    'obag': 'oversample ensemble',\n    'sbag': 'oversample ensemble',\n    'cost': 'cost sensitive',\n    'bag': 'standard ensemble' # We added this as a baseline earlier\n}\ndf['method_family'] = df['method'].map(family_mapping)\n\n# 5. Calculate Imbalance Ratio Groups\n# Assuming CLIMB standard groupings: <9 Low, 9-20 Medium, 20-50 High, >50 Extreme\ndef assign_ir_group(ir):\n    if ir < 9: return 'low'\n    elif ir < 20: return 'medium'\n    elif ir < 50: return 'high'\n    else: return 'extreme'\n    \ndf['ir_group'] = df['imbalance_ratio'].apply(assign_ir_group)\n\n# 6. Reorder columns to exactly match the professor's table\nrequired_columns = [\n    'run_id', 'timestamp', 'dataset', 'n_samples', 'n_features', \n    'imbalance_ratio', 'ir_group', 'method', 'method_family', \n    'base_classifier', 'ensemble_size', 'tuning_mode', 'fold', \n    'metric', 'value', 'fit_seconds', 'status', 'notes'\n]\n\n# Ensure no columns are dropped if there are extra notes, but match the order\ndf = df[required_columns]\n\n# Save the perfectly formatted CSV\ndf.to_csv(\"final_submission_results.csv\", index=False)\nprint(\"CSV successfully reformatted to match the professor's exact rubric!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-16T11:05:33.34869Z","iopub.execute_input":"2026-10-16T11:05:33.349035Z","iopub.status.idle":"2026-10-16T11:05:33.517159Z","shell.execute_reply.started":"2026-10-16T11:05:33.349006Z","shell.execute_reply":"2026-10-16T11:05:33.516258Z"}},"outputs":[{"name":"stdout","text":"CSV successfully reformatted to match the professor's exact rubric!\n","output_type":"stream"}],"execution_count":12},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom scipy.stats import kendalltau\n\n# 1. Load the perfectly formatted CSV\ndf = pd.read_csv(\"final_submission_results.csv\")\n\n# Filter for AUPRC only, and drop any crashed runs (though we know you have 0!)\ndf_auprc = df[(df['metric'] == 'auprc') & (df['status'] == 'ok')]\n\n# 2. Get the average AUPRC across the 5 folds for each Dataset + Method + Classifier\nmean_scores = df_auprc.groupby(['dataset', 'base_classifier', 'method'])['value'].mean().reset_index()\n\n# 3. Calculate Kendall Tau per dataset\ndatasets = mean_scores['dataset'].unique()\ntau_results = []\n\nfor ds in datasets:\n    ds_data = mean_scores[mean_scores['dataset'] == ds]\n    \n    # Pivot to align Decision Tree and Logistic Regression side-by-side per method\n    pivot_ds = ds_data.pivot(index='method', columns='base_classifier', values='value').dropna()\n    \n    # scipy.stats.kendalltau in one line, just like the professor asked\n    tau, p_val = kendalltau(pivot_ds['decision_tree'], pivot_ds['logistic_regression'])\n    tau_results.append({'dataset': ds, 'kendall_tau': tau})\n\ntau_df = pd.DataFrame(tau_results)\n\n# 4. Calculate Median and Interquartile Range (IQR)\nmedian_tau = tau_df['kendall_tau'].median()\nq1 = tau_df['kendall_tau'].quantile(0.25)\nq3 = tau_df['kendall_tau'].quantile(0.75)\niqr = q3 - q1\n\nprint(f\"--- KENDALL TAU STATISTICS ---\")\nprint(f\"Median Kendall Tau: {median_tau:.4f}\")\nprint(f\"IQR: {iqr:.4f} (Q1: {q1:.4f}, Q3: {q3:.4f})\")\nprint(f\"------------------------------\\n\")\n\n# 5. Generate Figure 1: The Kendall Tau Distribution\nplt.figure(figsize=(8, 5))\nsns.histplot(tau_df['kendall_tau'], bins=10, kde=True, color='#4C72B0', edgecolor='black')\n\n# Add vertical lines to clearly mark the Median and IQR for the paper\nplt.axvline(median_tau, color='#C44E52', linestyle='solid', linewidth=2.5, label=f'Median: {median_tau:.2f}')\nplt.axvline(q1, color='#55A868', linestyle='dashed', linewidth=2, label=f'Q1: {q1:.2f}')\nplt.axvline(q3, color='#55A868', linestyle='dashed', linewidth=2, label=f'Q3: {q3:.2f}')\n\nplt.title('Distribution of Kendall Tau Across 20 Datasets\\n(Decision Tree vs. Logistic Regression Rankings)', fontsize=14, pad=15)\nplt.xlabel('Kendall Tau Rank Correlation', fontsize=12)\nplt.ylabel('Number of Datasets', fontsize=12)\nplt.legend(loc='upper left', fontsize=11)\nplt.grid(axis='y', alpha=0.3)\n\nplt.tight_layout()\n\n# Save the figure to your Kaggle output directory so you can download it!\nplt.savefig('figure1_kendall_tau_distribution.png', dpi=300, bbox_inches='tight')\nplt.show()\n\n# Print the raw data just in case you want to see which dataset had which Tau\nprint(tau_df.sort_values(by='kendall_tau', ascending=False).to_string(index=False))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-16T11:05:51.019306Z","iopub.execute_input":"2026-10-16T11:05:51.019643Z","iopub.status.idle":"2026-10-16T11:05:51.988331Z","shell.execute_reply.started":"2026-10-16T11:05:51.019616Z","shell.execute_reply":"2026-10-16T11:05:51.987203Z"}},"outputs":[{"name":"stdout","text":"--- KENDALL TAU STATISTICS ---\nMedian Kendall Tau: 0.0545\nIQR: 0.3741 (Q1: -0.1091, Q3: 0.2650)\n------------------------------\n\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x500 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"                         dataset  kendall_tau\n                         vehicle     0.527273\n                          SPECTF     0.490909\n                           vowel     0.444444\n          ibm-employee-attrition     0.345455\n                         phoneme     0.293590\n                  planning-relax     0.236364\n             wholesale-customers     0.236364\n                  JapaneseVowels     0.200000\n                        haberman     0.163636\n                  bank-marketing     0.054545\n                           adult     0.000000\n                 vertebra-column    -0.018182\n                             pc4    -0.018182\n                             kc1    -0.090909\nblood-transfusion-service-center    -0.127273\n                thoracic-surgery    -0.163636\n                    ilpd-numeric    -0.163636\n  Credit_Approval_Classification    -0.309091\n                             mc2    -0.418182\n     law-school-admission-bianry          NaN\n","output_type":"stream"}],"execution_count":13},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom scipy.stats import friedmanchisquare\n\n# 1. Load data and aggregate average AUPRC per (dataset, base_classifier, method)\ndf = pd.read_csv(\"final_submission_results.csv\")\ndf_auprc = df[(df['metric'] == 'auprc') & (df['status'] == 'ok')]\nmean_scores = df_auprc.groupby(['dataset', 'base_classifier', 'method'])['value'].mean().reset_index()\n\nmethods = sorted(mean_scores['method'].unique())\n\n# Helper to compute ranks per dataset (1 = best/highest AUPRC)\ndef compute_ranks_and_friedman(clf_name):\n    clf_df = mean_scores[mean_scores['base_classifier'] == clf_name]\n    pivot_df = clf_df.pivot(index='dataset', columns='method', values='value').dropna()\n    \n    # Rank methods per dataset (ascending=False -> highest AUPRC gets rank 1)\n    ranks_df = pivot_df.rank(axis=1, ascending=False)\n    avg_ranks = ranks_df.mean(axis=0).sort_values()\n    \n    # Friedman Test across datasets\n    args = [pivot_df[m].values for m in pivot_df.columns]\n    stat, p_value = friedmanchisquare(*args)\n    \n    return avg_ranks, stat, p_value, pivot_df\n\ndt_ranks, dt_stat, dt_p, dt_pivot = compute_ranks_and_friedman('decision_tree')\nlr_ranks, lr_stat, lr_p, lr_pivot = compute_ranks_and_friedman('logistic_regression')\n\nprint(\"=== STATISTICAL SIGNIFICANCE TESTS (FRIEDMAN) ===\")\nprint(f\"Decision Tree       -> Chi2: {dt_stat:.2f}, p-value: {dt_p:.2e}\")\nprint(f\"Logistic Regression -> Chi2: {lr_stat:.2f}, p-value: {lr_p:.2e}\")\nprint(\"=================================================\\n\")\n\n# ---------------------------------------------------------\n# FIGURE 2: Side-by-Side Average Rank Comparison\n# ---------------------------------------------------------\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6), sharex=True)\n\nsns.barplot(x=dt_ranks.values, y=dt_ranks.index, ax=ax1, palette='Blues_r')\nax1.set_title(f'Decision Tree (Base)\\nFriedman $p$ = {dt_p:.1e}', fontsize=12, fontweight='bold')\nax1.set_xlabel('Average Rank (Lower is Better)', fontsize=11)\nax1.grid(axis='x', linestyle='--', alpha=0.5)\n\nsns.barplot(x=lr_ranks.values, y=lr_ranks.index, ax=ax2, palette='Oranges_r')\nax2.set_title(f'Logistic Regression (Base)\\nFriedman $p$ = {lr_p:.1e}', fontsize=12, fontweight='bold')\nax2.set_xlabel('Average Rank (Lower is Better)', fontsize=11)\nax2.grid(axis='x', linestyle='--', alpha=0.5)\n\nplt.suptitle('Figure 2: Method Rankings Comparison across 20 Datasets', fontsize=14, y=1.02)\nplt.tight_layout()\nplt.savefig('figure2_average_ranks_comparison.png', dpi=300, bbox_inches='tight')\nplt.show()\n\n# ---------------------------------------------------------\n# FIGURE 3: Ensemble Gain (Decision Tree vs Logistic Regression)\n# ---------------------------------------------------------\n# Calculate Ensemble Gain = Mean(AUPRC of Ensembles) - Base Model AUPRC\nensemble_methods = ['spe', 'ubag', 'obag', 'sbag', 'bag']\n\ndef get_ensemble_gain(pivot_df):\n    base_auprc = pivot_df['base']\n    ens_auprc = pivot_df[ensemble_methods].mean(axis=1)\n    return ens_auprc - base_auprc\n\ndt_gain = get_ensemble_gain(dt_pivot)\nlr_gain = get_ensemble_gain(lr_pivot)\n\n# Combine into common dataset index\ngain_df = pd.DataFrame({'DT_Gain': dt_gain, 'LR_Gain': lr_gain}).dropna()\n\nplt.figure(figsize=(8, 6))\nsns.scatterplot(data=gain_df, x='DT_Gain', y='LR_Gain', color='#2b5c8f', s=80, edgecolor='black', alpha=0.8)\n\n# Add y = x reference line\nmax_val = max(gain_df['DT_Gain'].max(), gain_df['LR_Gain'].max()) * 1.1\nmin_val = min(gain_df['DT_Gain'].min(), gain_df['LR_Gain'].min()) * 1.1\nplt.plot([min_val, max_val], [min_val, max_val], 'r--', label='Equal Gain Line (y = x)')\n\nplt.title('Figure 3: Ensemble Gain Over Baseline\\n(Decision Tree vs. Logistic Regression)', fontsize=13, pad=12)\nplt.xlabel('Ensemble Gain on Decision Tree (AUPRC Boost)', fontsize=11)\nplt.ylabel('Ensemble Gain on Logistic Regression (AUPRC Boost)', fontsize=11)\nplt.axhline(0, color='gray', linewidth=0.8, linestyle=':')\nplt.axvline(0, color='gray', linewidth=0.8, linestyle=':')\nplt.legend(loc='upper left')\nplt.grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.savefig('figure3_ensemble_gain_comparison.png', dpi=300, bbox_inches='tight')\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-16T11:06:02.972852Z","iopub.execute_input":"2026-10-16T11:06:02.973229Z","iopub.status.idle":"2026-10-16T11:06:05.215705Z","shell.execute_reply.started":"2026-10-16T11:06:02.973169Z","shell.execute_reply":"2026-10-16T11:06:05.21455Z"}},"outputs":[{"name":"stdout","text":"=== STATISTICAL SIGNIFICANCE TESTS (FRIEDMAN) ===\nDecision Tree       -> Chi2: 139.96, p-value: 4.30e-25\nLogistic Regression -> Chi2: 31.65, p-value: 4.57e-04\n=================================================\n\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x600 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x600 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":14},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.stats import friedmanchisquare, wilcoxon\nfrom statsmodels.stats.multitest import multipletests\n\n# 1. Load Data\ndf = pd.read_csv(\"final_submission_results.csv\")\ndf_auprc = df[(df['metric'] == 'auprc') & (df['status'] == 'ok')]\nmean_scores = df_auprc.groupby(['dataset', 'base_classifier', 'method'])['value'].mean().reset_index()\n\n# 2. Critical Difference (Demšar 2006) Plotting Function\ndef draw_cd_diagram(ax, avg_ranks, p_matrix, title, alpha=0.05):\n    \"\"\"\n    Plots a Demšar Critical Difference Diagram on the given Matplotlib axis.\n    Methods connected by a horizontal bar are NOT significantly different (p >= alpha).\n    \"\"\"\n    sorted_methods = avg_ranks.sort_values()\n    methods = sorted_methods.index.tolist()\n    ranks = sorted_methods.values\n    k = len(methods)\n    \n    # Configure axis line\n    ax.set_title(title, fontsize=12, fontweight='bold', pad=25)\n    ax.set_xlim(0.5, k + 0.5)\n    ax.set_ylim(-1.5, 3.5)\n    ax.spines['top'].set_position(('data', 0))\n    ax.spines['top'].set_color('black')\n    ax.spines['top'].set_linewidth(1.5)\n    ax.spines['bottom'].set_visible(False)\n    ax.spines['left'].set_visible(False)\n    ax.spines['right'].set_visible(False)\n    ax.yaxis.set_visible(False)\n    \n    # Tick marks for ranks (1 = best)\n    ax.xaxis.set_ticks_position('top')\n    ax.set_xticks(range(1, k + 1))\n    ax.set_xticklabels([str(i) for i in range(1, k + 1)], fontsize=10, fontweight='bold')\n    ax.set_xlabel('Average Rank (Lower = Better)', fontsize=11, labelpad=10)\n    ax.xaxis.set_label_position('top')\n    \n    # Plot method markers & labels\n    half = (k + 1) // 2\n    y_top = 0.5\n    y_bottom = -0.5\n    \n    for i, (method, rank) in enumerate(zip(methods, ranks)):\n        # Alternate text positioning above/below line to prevent overlapping\n        if i < half:\n            y_pos = y_top + (i % 3) * 0.4\n            va = 'bottom'\n            y_line_end = y_pos - 0.05\n        else:\n            y_pos = y_bottom - ((i - half) % 3) * 0.4\n            va = 'top'\n            y_line_end = y_pos + 0.05\n            \n        ax.plot([rank, rank], [0, y_line_end], color='#444444', linestyle=':', linewidth=1)\n        ax.plot(rank, 0, marker='o', color='#1f77b4', markersize=6)\n        ax.text(rank, y_pos, f\"{method} ({rank:.2f})\", rotation=45, ha='left', va=va, fontsize=9, fontweight='semibold')\n        \n    # Find cliques of non-significantly different methods (p >= alpha) and draw horizontal bars\n    cliques = []\n    for i in range(k):\n        j_max = i\n        for j in range(i + 1, k):\n            m1, m2 = methods[i], methods[j]\n            # Check pairwise p-value\n            if p_matrix.loc[m1, m2] >= alpha:\n                j_max = j\n        if j_max > i:\n            cliques.append((ranks[i], ranks[j_max]))\n            \n    # Filter overlapping sub-cliques for a clean visual\n    filtered_cliques = []\n    for start, end in cliques:\n        if not any(c_s <= start and c_e >= end and (c_s < start or c_e > end) for c_s, c_e in cliques):\n            filtered_cliques.append((start, end))\n            \n    # Draw CD connecting lines\n    bar_y = 0.15\n    for start, end in filtered_cliques:\n        ax.plot([start, end], [bar_y, bar_y], color='#d62728', linewidth=3.5, solid_capstyle='round')\n        bar_y += 0.08\n\n# 3. Compute Ranks, Friedman Test, and Pairwise Wilcoxon-Holm p-values\ndef process_classifier(clf_name):\n    clf_df = mean_scores[mean_scores['base_classifier'] == clf_name]\n    pivot_df = clf_df.pivot(index='dataset', columns='method', values='value').dropna()\n    \n    # Ranks (1 = highest AUPRC)\n    ranks_df = pivot_df.rank(axis=1, ascending=False)\n    avg_ranks = ranks_df.mean(axis=0)\n    \n    # Friedman Test\n    stat, p_val = friedmanchisquare(*[pivot_df[c].values for c in pivot_df.columns])\n    \n    # Pairwise Wilcoxon Signed-Rank Test with Holm Correction\n    methods = pivot_df.columns.tolist()\n    n_methods = len(methods)\n    p_matrix = pd.DataFrame(1.0, index=methods, columns=methods)\n    \n    p_vals_list = []\n    pairs = []\n    for i in range(n_methods):\n        for j in range(i + 1, n_methods):\n            m1, m2 = methods[i], methods[j]\n            _, p = wilcoxon(pivot_df[m1], pivot_df[m2])\n            p_vals_list.append(p)\n            pairs.append((m1, m2))\n            \n    # Holm-Bonferroni correction\n    _, p_corrected, _, _ = multipletests(p_vals_list, method='holm')\n    for (m1, m2), p_corr in zip(pairs, p_corrected):\n        p_matrix.loc[m1, m2] = p_corr\n        p_matrix.loc[m2, m1] = p_corr\n        \n    return avg_ranks, stat, p_val, p_matrix\n\ndt_ranks, dt_stat, dt_p, dt_p_mat = process_classifier('decision_tree')\nlr_ranks, lr_stat, lr_p, lr_p_mat = process_classifier('logistic_regression')\n\n# 4. Generate Figure 2 Side-by-Side\nfig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 10))\n\ndraw_cd_diagram(ax1, dt_ranks, dt_p_mat, f\"Decision Tree Base Learner (Friedman $\\chi^2$ = {dt_stat:.2f}, $p$ = {dt_p:.2e})\")\ndraw_cd_diagram(ax2, lr_ranks, lr_p_mat, f\"Logistic Regression Base Learner (Friedman $\\chi^2$ = {lr_stat:.2f}, $p$ = {lr_p:.2e})\")\n\nplt.suptitle(\"Critical Difference (CD) Diagrams (Wilcoxon-Holm Post-Hoc, $\\\\alpha=0.05$)\\nRed lines connect methods with no statistically significant performance difference.\", fontsize=13, y=0.98, fontweight='bold')\nplt.tight_layout(rect=[0, 0, 1, 0.95])\n\n# Save high-res figure for paper\nplt.savefig(\"figure4_critical_difference_diagrams.png\", dpi=300, bbox_inches='tight')\nplt.show()\n\nprint(\"✅ Figure 4 successfully generated and saved as 'figure_critical_difference_diagrams.png'!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-16T12:14:01.288945Z","iopub.execute_input":"2026-10-16T12:14:01.289422Z","iopub.status.idle":"2026-10-16T12:14:03.112031Z","shell.execute_reply.started":"2026-10-16T12:14:01.289391Z","shell.execute_reply":"2026-10-16T12:14:03.111239Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1000 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"✅ Figure 4 successfully generated and saved as 'figure_critical_difference_diagrams.png'!\n","output_type":"stream"}],"execution_count":21},{"cell_type":"code","source":"import os\nfrom IPython.display import FileLink, display\n\n# List all files currently in the working directory\nworking_files = os.listdir('/kaggle/working')\nprint(\"Files found in /kaggle/working:\")\nfor f in working_files:\n    print(f\" - {f}\")\n\nprint(\"\\n--- Download Links ---\")\nfor file_name in ['results_full_sweep.csv', 'final_submission_results.csv']:\n    if file_name in working_files:\n        print(f\"Click below to download {file_name}:\")\n        display(FileLink(file_name))  ","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-16T12:14:09.061405Z","iopub.execute_input":"2026-10-16T12:14:09.061739Z","iopub.status.idle":"2026-10-16T12:14:09.073055Z","shell.execute_reply.started":"2026-10-16T12:14:09.061712Z","shell.execute_reply":"2026-10-16T12:14:09.072266Z"}},"outputs":[{"name":"stdout","text":"Files found in /kaggle/working:\n - results\n - figure1_kendall_tau_distribution.png\n - figure3_ensemble_gain_comparison.png\n - .virtual_documents\n - results_full_sweep.csv\n - figure4_critical_difference_diagrams.png\n - figure2_critical_difference_diagrams.png\n - figure2_average_ranks_comparison.png\n - final_submission_results.csv\n\n--- Download Links ---\nClick below to download results_full_sweep.csv:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"/kaggle/working/results_full_sweep.csv","text/html":"<a href='results_full_sweep.csv' target='_blank'>results_full_sweep.csv</a><br>"},"metadata":{}},{"name":"stdout","text":"Click below to download final_submission_results.csv:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"/kaggle/working/final_submission_results.csv","text/html":"<a href='final_submission_results.csv' target='_blank'>final_submission_results.csv</a><br>"},"metadata":{}}],"execution_count":22},{"cell_type":"code","source":"import os\nfrom IPython.display import FileLink, display\n\n# List all files currently in the working directory\nworking_files = os.listdir('/kaggle/working')\nprint(\"Files found in /kaggle/working:\")\nfor f in working_files:\n    print(f\" - {f}\")\n\nprint(\"\\n--- Download Links ---\")\nfor file_name in ['results_full_sweep.csv', 'final_submission_results.csv']:\n    if file_name in working_files:\n        print(f\"Click below to download {file_name}:\")\n        display(FileLink(file_name))  ","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-16T13:07:19.750521Z","iopub.execute_input":"2026-10-16T13:07:19.750846Z","iopub.status.idle":"2026-10-16T13:07:19.757909Z","shell.execute_reply.started":"2026-10-16T13:07:19.750821Z","shell.execute_reply":"2026-10-16T13:07:19.757104Z"}},"outputs":[{"name":"stdout","text":"Files found in /kaggle/working:\n - .virtual_documents\n\n--- Download Links ---\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}